@model IEnumerable<Venue>

@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Venues</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Venue</a>
</div>

@{
    var currentAvailability = ViewData["CurrentAvailability"] as string;
    var availabilityOptions = new List<SelectListItem>
    {
        new SelectListItem("All venues", "", string.IsNullOrEmpty(currentAvailability)),
        new SelectListItem("Available only", "available", currentAvailability == "available"),
        new SelectListItem("Unavailable only", "unavailable", currentAvailability == "unavailable")
    };
}

<form asp-action="Index" method="get" class="mb-4 d-flex flex-wrap gap-2">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
           class="form-control flex-grow-1" style="min-width:220px;max-width:none;width:auto;" placeholder="Search by name or location..." />
    <select name="availability" class="form-select" style="width:auto;" asp-items="availabilityOptions"></select>
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No venues found.</p>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var venue in Model)
    {
        <div class="col">
            <div class="card h-100 venue-card">
                <img src="@(string.IsNullOrEmpty(venue.ImageUrl) ? "https://via.placeholder.com/400x250?text=No+Image" : venue.ImageUrl)" class="card-img-top" alt="@venue.VenueName" />
                <div class="card-body">
                    <h5 class="card-title d-flex justify-content-between align-items-start gap-2">
                        <span>@venue.VenueName</span>
                        @if (venue.IsAvailable)
                        {
                            <span class="badge rounded-pill text-bg-success fs-6 fw-normal" style="font-size:.72rem!important;">Available</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-secondary fs-6 fw-normal" style="font-size:.72rem!important;">Unavailable</span>
                        }
                    </h5>
                    <p class="card-text mb-1"><strong>Location:</strong> @venue.Location</p>
                    <p class="card-text"><strong>Capacity:</strong> @venue.Capacity</p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Details" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>
