@model Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<h1>Delete Venue</h1>

<div class="alert alert-warning">Are you sure you want to delete this venue?</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.VenueName)</dt>
            <dd class="col-sm-8">@Model.VenueName</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Location)</dt>
            <dd class="col-sm-8">@Model.Location</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Capacity)</dt>
            <dd class="col-sm-8">@Model.Capacity</dd>
        </dl>

        @if (Model.Bookings != null && Model.Bookings.Any())
        {
            <div class="alert alert-danger">
                This venue has @Model.Bookings.Count() existing booking(s) and cannot be deleted.
            </div>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        }
        else
        {
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="VenueId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
