@model Venue

@{
    ViewData["Title"] = "Venue Details";
}

<h1>Venue Details</h1>

<div class="row">
    <div class="col-md-5">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400x250?text=No+Image" : Model.ImageUrl)" class="img-fluid rounded mb-3" alt="@Model.VenueName" />
    </div>
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.VenueName)</dt>
            <dd class="col-sm-9">@Model.VenueName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Location)</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Capacity)</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Availability</dt>
            <dd class="col-sm-9">
                @if (Model.IsAvailable)
                {
                    <span class="badge text-bg-success">Available for booking</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Unavailable</span>
                }
            </dd>
        </dl>

        <h5 class="mt-4">Events at this venue</h5>
        @if (Model.Events != null && Model.Events.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var ev in Model.Events)
                {
                    <li class="list-group-item">@ev.EventName - @ev.StartDateTime.ToString("g")</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No events linked yet.</p>
        }

        <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>
