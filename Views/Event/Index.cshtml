@model IEnumerable<Event>

@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Event</a>
</div>

<form asp-action="Index" method="get" class="mb-4 d-flex flex-wrap gap-2">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
           class="form-control flex-grow-1" style="min-width:220px;width:auto;" placeholder="Search by event name..." />
    <select name="eventTypeId" class="form-select" style="width:auto;" asp-items="ViewBag.EventTypeFilter">
        <option value="">All event types</option>
    </select>
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>@Html.DisplayNameFor(m => m.EventName)</th>
            <th>Type</th>
            <th>@Html.DisplayNameFor(m => m.StartDateTime)</th>
            <th>@Html.DisplayNameFor(m => m.EndDateTime)</th>
            <th>Venue</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>
                    <img src="@(string.IsNullOrEmpty(ev.ImageUrl) ? "https://via.placeholder.com/80x60?text=No+Image" : ev.ImageUrl)"
                         alt="@ev.EventName" style="width:80px;height:60px;object-fit:cover;" class="rounded" />
                </td>
                <td>@ev.EventName</td>
                <td>
                    @if (ev.EventType != null)
                    {
                        <span class="badge rounded-pill text-bg-light border">@ev.EventType.Name</span>
                    }
                    else
                    {
                        <span class="text-muted small">Unclassified</span>
                    }
                </td>
                <td>@ev.StartDateTime.ToString("g")</td>
                <td>@ev.EndDateTime.ToString("g")</td>
                <td>@(ev.Venue?.VenueName ?? "Not yet assigned")</td>
                <td>@ev.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
